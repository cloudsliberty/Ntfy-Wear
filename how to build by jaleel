use following 

# 1. Stop any running background Gradle daemons
./gradlew --stop

# 2. Clean build artifacts
./gradlew clean

# 3. Manually remove the build directories (if running in a Linux/container environment)
rm -rf build app/build

# 4. Rebuild with cache disabled and forced task rerun
./gradlew :app:compileDebugKotlin --no-build-cache --rerun-tasks --console=plain



final release build
./gradlew :app:assembleRelease